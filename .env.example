# Simulation by default: no hardware commands
XR18_MODE=simulation
XR18_HOST=192.168.1.100
XR18_PORT=10024
HTTP_PORT=3000
# To allow hardware writes, explicitly set both XR18_MODE=real and XR18_ENABLE_WRITES=true
XR18_ENABLE_WRITES=false


# Experimental typed FX writes; leave disabled until tested with your XR18
XR18_EXPERIMENTAL_FX=false

# Full native scene recall: experimental, disabled until controlled hardware validation
XR18_EXPERIMENTAL_SCENES=false


# Dialogue IA facultatif : conserver la clé sur le serveur uniquement.
# Dans l’application de bureau, utiliser plutôt le formulaire Mon ingé son.
# XR18_OPENAI_API_KEY=
# XR18_OPENAI_MODEL=
