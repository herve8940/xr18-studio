{
  "name": "xr18-studio",
  "version": "2.0.2",
  "description": "Free app for the Behringer XR18 / X18 / MR18 mixer: guided sound engineer for beginners, X-AIR Edit style graphical console, in-ear monitors on each musician's phone.",
  "keywords": [
    "behringer",
    "xr18",
    "x18",
    "mr18",
    "x-air",
    "xair",
    "x-air-edit",
    "midas",
    "mixer",
    "digital-mixer",
    "osc",
    "live-sound",
    "sound-engineer",
    "in-ear-monitor",
    "monitor-mix",
    "electron",
    "react"
  ],
  "homepage": "https://herve8940.github.io/xr18-studio/",
  "bugs": {
    "url": "https://github.com/herve8940/xr18-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/herve8940/xr18-studio.git"
  },
  "license": "MIT",
  "author": {
    "name": "Hervé Naessens"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup": "npm install && npm --prefix web install",
    "studio": "concurrently --kill-others -n API,WEB -c blue,green \"npm run dev\" \"npm --prefix web run dev\"",
    "build:all": "npm run build && npm --prefix web run build",
    "desktop:dev": "npm run build:all && electron .",
    "desktop:package": "npm run build:all && electron-builder --publish never",
    "mcp": "tsx src/mcp.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "be.xr18.studio",
    "productName": "XR18 Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/src/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "extraResources": [
      {
        "from": "web/dist",
        "to": "web-dist"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "XR18-Studio-Windows-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "artifactName": "XR18-Studio-macOS-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "XR18 Studio communique avec ta table Behringer XR18 sur le réseau local (OSC/UDP) et partage les retours avec les téléphones des musiciens.",
        "NSBonjourServices": [
          "_osc._udp",
          "_http._tcp"
        ]
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "artifactName": "XR18-Studio-Linux-${version}-${arch}.${ext}",
      "maintainer": "Hervé Naessens"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
